   "source": [
    "# Donuts charts can be created using the pie chart function in matplotlib, where a circle is added at the center to create the donut shape. For example, to create a donut chart showing the distribution of 'Seller_Type':\n",
    "plt.figure(figsize=(8, 5))\n",
    "df['Seller_Type'].value_counts().plot(kind='pie', autopct='%1.1f%%', startangle=90, colors=sns.color_palette('Set2'))\n",
    "plt.title('Distribution of Seller Type', fontsize=16)\n",
    "plt.ylabel('')\n",
    "plt.legend(title='Seller Type', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.axis('equal')  # Equal aspect ratio ensures that pie chart is circular\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
