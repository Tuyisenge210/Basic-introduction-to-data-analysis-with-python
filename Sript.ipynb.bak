     ]
    }
   ],
   "source": [
    "from jupyter_dash import JupyterDash\n",
    "import dash\n",
    "from dash import html, dcc, Input, Output\n",
    "import plotly.express as px\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv('car price data.csv')\n",
    "\n",
    "app = JupyterDash(__name__)\n",
    "\n",
    "app.layout = html.Div([\n",
    "    html.H1('Car Price Dashboard'),\n",
    "    dcc.Dropdown(\n",
    "        id='fuel-dropdown',\n",
    "        options=[{'label': f, 'value': f} for f in df['Fuel_Type'].unique()],\n",
    "        value=None,\n",
    "        placeholder='Select Fuel Type'\n",
    "    ),\n",
    "    html.Div(id='kpis'),\n",
    "    dcc.Graph(id='fuel-price-chart'),\n",
    "    dcc.Graph(id='fuel-trans-chart'),\n",
    "    dcc.Graph(id='fuel-seller-chart'),\n",
    "    dcc.Graph(id='price-pivot-chart')\n",
    "])\n",
    "\n",
    "@app.callback(\n",
    "    [Output('kpis', 'children'),\n",
    "     Output('fuel-price-chart', 'figure'),\n",
    "     Output('fuel-trans-chart', 'figure'),\n",
    "     Output('fuel-seller-chart', 'figure'),\n",
    "     Output('price-pivot-chart', 'figure')],\n",
    "    Input('fuel-dropdown', 'value')\n",
    ")\n",
    "def update_dashboard(fuel):\n",
    "    filtered_df = df if fuel is None else df[df['Fuel_Type'] == fuel]\n",
    "    \n",
    "    # KPIs\n",
    "    kpis = [\n",
    "        html.Div(f\"Total Cars: {len(filtered_df)}\"),\n",
    "        html.Div(f\"Avg Selling Price: {filtered_df['Selling_Price'].mean():.2f}\"),\n",
    "        html.Div(f\"Max Selling Price: {filtered_df['Selling_Price'].max()}\")\n",
    "    ]\n",
    "    \n",
    "    # Charts\n",
    "    fuel_price = filtered_df.groupby('Fuel_Type')['Selling_Price'].mean().reset_index()\n",
    "    fig1 = px.bar(fuel_price, x='Fuel_Type', y='Selling_Price', title='Avg Selling Price by Fuel')\n",
    "    \n",
    "    fuel_trans = pd.crosstab(filtered_df['Fuel_Type'], filtered_df['Transmission']).reset_index().melt(id_vars='Fuel_Type')\n",
    "    fig2 = px.bar(fuel_trans, x='Fuel_Type', y='value', color='Transmission', title='Fuel vs Transmission')\n",
    "    \n",
    "    fuel_seller = pd.crosstab(filtered_df['Fuel_Type'], filtered_df['Seller_Type']).reset_index().melt(id_vars='Fuel_Type')\n",
    "    fig3 = px.bar(fuel_seller, x='Fuel_Type', y='value', color='Seller_Type', title='Fuel vs Seller Type')\n",
    "    \n",
    "    price_pivot = filtered_df.pivot_table(index='Fuel_Type', columns='Transmission', values=['Selling_Price', 'Present_Price'], aggfunc='mean').round(2)\n",
    "    fig4 = px.imshow(price_pivot, title='Pivot: Avg Selling & Present Price')\n",
    "    \n",
    "    return kpis, fig1, fig2, fig3, fig4\n",
    "\n",
    "app.run_server(mode='inline')"
   ]
  },
