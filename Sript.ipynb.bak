   "source": [
    "#Visualize Pair plots, Line plots, Area plots, Heatmaps, Bubble charts\n",
    "# For example, to visualize the relationships between multiple numerical variables in the dataset, you can create a pair plot:\n",
    "\n",
    "# sns.pairplot(df[['Selling_Price', 'Present_Price', 'Kms_Driven', 'Age']], diag_kind='kde', hue='Fuel_Type', palette='Set2')\n",
    "# plt.suptitle('Pair Plot of Numerical Variables by Fuel Type', fontsize=16)\n",
    "# plt.tight_layout()\n",
    "# plt.show()\n",
    "\n",
    "# # You can customize the pair plot by changing the diagonal kind (e.g., 'hist' for histograms) or by adjusting the color palette and styling to enhance the visualization.\n",
    "# sns.pairplot(df[['Selling_Price', 'Present_Price', 'Kms_Driven', 'Age']], diag_kind='hist', hue='Fuel_Type', palette='Set2')\n",
    "# plt.suptitle('Pair Plot of Numerical Variables by Fuel Type', fontsize=16)\n",
    "# plt.tight_layout()\n",
    "# plt.show()\n",
    "\n",
    "# You can also create a heatmap to visualize the correlation between numerical variables in the dataset:\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.heatmap(df[['Selling_Price', 'Present_Price', 'Kms_Driven', 'Age']].corr(), annot=True, cmap='coolwarm', linewidths=0.5)\n",
    "plt.title('Correlation Heatmap of Numerical Variables', fontsize=16)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can further customize the heatmap by adjusting the color palette, adding a mask to hide the upper triangle, or by changing the annotation format to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.heatmap(df[['Selling_Price', 'Present_Price', 'Kms_Driven', 'Age']].corr(), annot=True, cmap='coolwarm', linewidths=0.5, mask=np.triu(np.ones_like(df[['Selling_Price', 'Present_Price', 'Kms_Driven', 'Age']].corr(), dtype=bool)))\n",
    "plt.title('Correlation Heatmap of Numerical Variables (with mask)', fontsize=16)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
