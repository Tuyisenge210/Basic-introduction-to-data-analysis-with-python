   "source": [
    "# We are going to make a cross tabulation between two categorical variables\n",
    "# pip install openpyxl\n",
    "def tabulate(df, var1, var2):\n",
    "    table = pd.crosstab(df[var1], df[var2])\n",
    "    return table    \n",
    "tabulate(df, 'Fuel_Type', 'Seller_Type')\n",
    "# Export the crosstab to a Excel file\n",
    "# crosstab = tabulate(df, 'Fuel_Type', 'Seller_Type')\n",
    "# crosstab.to_excel('crosstab_fuel_seller.xlsx', index=True)"
   ]
  },
