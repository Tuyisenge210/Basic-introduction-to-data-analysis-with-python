   "source": [
    "# Using Plotly to create an interactive bar chart showing the count of cars by 'Fuel_Type':\n",
    "import plotly.express as px\n",
    "fuel_counts = df['Fuel_Type'].value_counts().reset_index()\n",
    "fuel_counts.columns = ['Fuel_Type', 'Count']\n",
    "fig = px.bar(fuel_counts, x='Fuel_Type', y='Count', color='Fuel_Type', title='Count of Cars by Fuel Type')\n",
    "fig.show()"
   ]
  },
