    "# You can also create a pie chart to visualize the proportion of different categories in a variable. For example, to visualize the distribution of 'Fuel_Type':\n",
    "plt.figure(figsize=(8, 5))\n",
    "df['Fuel_Type'].value_counts().plot(kind='pie', autopct='%1.1f%%', startangle=90, colors=sns.color_palette('Set2'))\n",
    "plt.title('Distribution of Fuel Type', fontsize=16)\n",
    "plt.ylabel('')\n",
    "plt.axis('equal')  # Equal aspect ratio ensures that pie chart is circular\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can customize the pie chart further by adjusting the color palette, changing the start angle, or by adding a legend to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "df['Fuel_Type'].value_counts().plot(kind='pie', autopct='%1.1f%%', startangle=90, colors=sns.color_palette('Set2'))\n",
    "plt.title('Distribution of Fuel Type', fontsize=16)\n",
    "plt.ylabel('')\n",
    "plt.legend(title='Fuel Type', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.axis('equal')  # Equal aspect ratio ensures that pie chart is circular\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
