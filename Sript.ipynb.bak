   "source": [
    "#Other graphs mainly sccatter, Pie charts, Box plots, Violin plots, Pair plots, Line plots, Area plots, Heatmaps, Bubble charts, etc. can also be used to visualize the data depending on the type of analysis you want to perform.\n",
    "# For example, to visualize the relationship between 'Selling_Price' and 'Present_Price', you can use a scatter plot:\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.scatterplot(x='Present_Price', y='Selling_Price', data=df, hue='Fuel_Type', palette='Set1')\n",
    "plt.title('Selling Price vs Present Price by Fuel Type', fontsize=16)\n",
    "plt.xlabel('Present Price', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.legend(title='Fuel Type')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can customize the scatter plot further by adding regression lines, adjusting point sizes, or using different color palettes to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.scatterplot(x='Present_Price', y='Selling_Price', data=df, hue='Fuel_Type', palette='Set1', s=100, alpha=0.7)\n",
    "sns.regplot(x='Present_Price', y='Selling_Price', data=df, scatter=False, color='black', line_kws={'linewidth': 1, 'linestyle': '--'})\n",
    "plt.title('Selling Price vs Present Price by Fuel Type', fontsize=16)\n",
    "plt.xlabel('Present Price', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.legend(title='Fuel Type')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show() \n",
    "\n",
    "# You can also create a box plot to visualize the distribution of 'Selling_Price' across different 'Fuel_Type':\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.boxplot(x='Fuel_Type', y='Selling_Price', data=df, palette='Set3')\n",
    "plt.title('Box Plot of Selling Price by Fuel Type', fontsize=16)\n",
    "plt.xlabel('Fuel Type', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
