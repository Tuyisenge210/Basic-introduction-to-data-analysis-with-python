   "source": [
    "#Filter cars that has fuel type petrol and selling price greater than 5 and are manuals\n",
    "df[(df['Fuel_Type'] == 'Petrol') & (df['Selling_Price'] > 5) & (df['Transmission'] == 'Manual')]\n",
    "df.loc[(df['Fuel_Type'] == 'Petrol') & (df['Selling_Price'] > 5) & (df['Transmission'] == 'Manual'), :]\n",
    "\n",
    "## Two ways of doing the same thing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "3fed4708",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['Car_Name', 'Year', 'Selling_Price', 'Present_Price', 'Kms_Driven',\n",
       "       'Fuel_Type', 'Seller_Type', 'Transmission', 'Owner', 'Age'],\n",
       "      dtype='str')"
      ]
     },
     "execution_count": 42,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import datetime\n",
    "df['Age']=datetime.datetime.now().year-df['Year'] #This will add new column of age in dataset\n",
    "df[['Age']]\n",
    "df.columns"
   ]
  },
