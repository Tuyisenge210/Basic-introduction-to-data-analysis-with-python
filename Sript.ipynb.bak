   ],
   "source": [
    "#Now we are going to use Dash library to create interactive visualizations. For example, to create an interactive scatter plot of 'Present_Price' vs 'Selling_Price' colored by 'Fuel_Type':\n",
    "import dash\n",
    "from dash import dcc, html\n",
    "import plotly.express as px\n",
    "from dash.dependencies import Input, Output\n",
    "app = dash.Dash(__name__)\n",
    "app.layout = html.Div([\n",
    "    html.H1(\"Car Dataset Dashboard\"),\n",
    "    dcc.Dropdown(\n",
    "        id='fuel-type-dropdown',\n",
    "        options=[{'label': fuel, 'value': fuel} for fuel in df['Fuel_Type'].unique()],\n",
    "        value='All',\n",
    "        clearable=False\n",
    "    ),\n",
    "    dcc.Graph(id='scatter-plot')\n",
    "])\n",
    "@app.callback(\n",
    "    Output('scatter-plot', 'figure'),\n",
    "    [Input('fuel-type-dropdown', 'value')]\n",
    ")\n",
    "def update_scatter_plot(selected_fuel):\n",
    "    if selected_fuel == 'All':\n",
    "        filtered_df = df\n",
    "    else:\n",
    "        filtered_df = df[df['Fuel_Type'] == selected_fuel]\n",
    "    fig = px.scatter(filtered_df, x='Present_Price', y='Selling_Price', color='Fuel_Type', title='Selling Price vs Present Price by Fuel Type')\n",
    "    return fig\n",
    "if __name__ == '__main__':\n",
    "    app.run(debug=True)\n",
    "#This code sets up a Dash application with a dropdown menu to filter the scatter plot by 'Fuel_Type'. The scatter plot updates dynamically based on the selected fuel type, allowing for interactive exploration of the relationship between 'Present_Price' and 'Selling_Price' across different fuel types.   \n"
   ]
  },
