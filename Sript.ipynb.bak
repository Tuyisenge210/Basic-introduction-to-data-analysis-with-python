   "source": [
    "# You can further customize the interactive scatter plot by adding more tools (e.g., zoom, pan), adjusting the color palette, or by adding regression lines to enhance the visualization.\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.io import output_notebook\n",
    "from bokeh.models import ColumnDataSource, HoverTool\n",
    "from bokeh.transform import factor_cmap\n",
    "from bokeh.palettes import Category10\n",
    "output_notebook()\n",
    "source = ColumnDataSource(df)\n",
    "hover = HoverTool(tooltips=[\n",
    "    (\"Present Price\", \"@Present_Price\"),\n",
    "    (\"Selling Price\", \"@Selling_Price\"),\n",
    "    (\"Fuel Type\", \"@Fuel_Type\")])\n",
    "p = figure(title='Selling Price vs Present Price by Fuel Type', x_axis_label='Present Price', y_axis_label='Selling Price', width=800, height=500, tools=[hover, 'pan', 'wheel_zoom', 'box_zoom', 'reset'])\n",
    "p.scatter(x='Present_Price', y='Selling_Price', source=source, color=factor_cmap('Fuel_Type', palette=Category10[3], factors=df['Fuel_Type'].unique()), size=10, alpha=0.7)\n",
    "show(p)"
   ]
  },
