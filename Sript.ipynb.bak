      "application/javascript": "(function(root) {\n  function embed_document(root) {\n  const docs_json = {\"d2026da9-bd64-493c-95b4-91a65f0773c0\":{\"version\":\"3.9.0\",\"title\":\"Bokeh Application\",\"config\":{\"type\":\"object\",\"name\":\"DocumentConfig\",\"id\":\"p1258\",\"attributes\":{\"notifications\":{\"type\":\"object\",\"name\":\"Notifications\",\"id\":\"p1259\"}}},\"roots\":[{\"type\":\"object\",\"name\":\"Figure\",\"id\":\"p1218\",\"attributes\":{\"width\":800,\"height\":500,\"x_range\":{\"type\":\"object\",\"name\":\"DataRange1d\",\"id\":\"p1219\"},\"y_range\":{\"type\":\"object\",\"name\":\"DataRange1d\",\"id\":\"p1220\"},\"x_scale\":{\"type\":\"object\",\"name\":\"LinearScale\",\"id\":\"p1228\"},\"y_scale\":{\"type\":\"object\",\"name\":\"LinearScale\",\"id\":\"p1229\"},\"title\":{\"type\":\"object\",\"name\":\"Title\",\"id\":\"p1221\",\"attributes\":{\"text\":\"Selling Price vs Present Price by Fuel Type\"}},\"renderers\":[{\"type\":\"object\",\"name\":\"GlyphRenderer\",\"id\":\"p1255\",\"attributes\":{\"data_source\":{\"type\":\"object\",\"name\":\"ColumnDataSource\",\"id\":\"p1214\",\"attributes\":{\"selected\":{\"type\":\"object\",\"name\":\"Selection\",\"id\":\"p1215\",\"attributes\":{\"indices\":[],\"line_indices\":[]}},\"selection_policy\":{\"type\":\"object\",\"name\":\"UnionRenderers\",\"id\":\"p1216\"},\"data\":{\"type\":\"map\",\"entries\":[[\"index\",{\"type\":\"ndarray\",\"array\":{\"type\":\"bytes\",\"data\":\"\"},\"shape\":[301],\"dtype\":\"int32\",\"order\":\"little\"}],[\"Car_Name\",{\"type\":\"ndarray\",\"array\":[\"ritz\",\"sx4\",\"ciaz\",\"wagon r\",\"swift\",\"vitara brezza\",\"ciaz\",\"s cross\",\"ciaz\",\"ciaz\",\"alto 800\",\"ciaz\",\"ciaz\",\"ertiga\",\"dzire\",\"ertiga\",\"ertiga\",\"ertiga\",\"wagon r\",\"sx4\",\"alto k10\",\"ignis\",\"sx4\",\"alto k10\",\"wagon r\",\"swift\",\"swift\",\"swift\",\"alto k10\",\"ciaz\",\"ritz\",\"ritz\",\"swift\",\"ertiga\",\"dzire\",\"sx4\",\"dzire\",\"800\",\"alto k10\",\"sx4\",\"baleno