   "source": [
    "#Now we are going to use Plotly library to create interactive visualizations. For example, to create an interactive scatter plot of 'Present_Price' vs 'Selling_Price' colored by 'Fuel_Type':\n",
    "import plotly.express as px\n",
    "fig = px.scatter(df, x='Present_Price', y='Selling_Price', color='Fuel_Type', title='Selling Price vs Present Price by Fuel Type')\n",
    "fig.show()"
   ]
  },
