   "source": [
    "# Violin plots can be used to visualize the distribution of a numerical variable across different categories. For example, to visualize the distribution of 'Selling_Price' across different 'Fuel_Type':\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.violinplot(x='Fuel_Type', y='Selling_Price', data=df, palette='Set3')\n",
    "plt.title('Violin Plot of Selling Price by Fuel Type', fontsize=16)\n",
    "plt.xlabel('Fuel Type', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
