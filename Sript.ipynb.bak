   "source": [
    "# Make the visualisation interactive by adding hover tooltips\n",
    "from bokeh.models import HoverTool\n",
    "hover = HoverTool(tooltips=[\n",
    "    (\"Present Price\", \"@Present_Price\"),\n",
    "    (\"Selling Price\", \"@Selling_Price\"),\n",
    "    (\"Fuel Type\", \"@Fuel_Type\")\n",
    "])\n",
    "source = ColumnDataSource(df)\n",
    "p = figure(title='Selling Price vs Present Price by Fuel Type', x_axis_label='Present Price', y_axis_label='Selling Price', width=800, height=500, tools=[hover])\n",
    "p.scatter(x='Present_Price', y='Selling_Price', source=source, color=factor_cmap('Fuel_Type', palette=Category10[3], factors=df['Fuel_Type'].unique()))\n",
    "show(p)"
   ]
  },
