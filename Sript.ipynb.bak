   "source": [
    "# Making it more interactive by adding dropdowns to filter the data by 'Fuel_Type' in the scatter plot and bar chart again addings cards to show the key metrics of the dataset like average selling price, total number of cars and more using Plotly library:\n",
    "import plotly.express as px\n",
    "from plotly.subplots import make_subplots\n",
    "import plotly.graph_objects as go\n",
    "# Create subplots\n",
    "fig = make_subplots(rows=2, cols=2, subplot_titles=('Selling Price vs Present Price by Fuel Type', 'Count of Cars by Fuel Type', 'Average Selling Price by Year', 'Distribution of Selling Price'))\n",
    "# Scatter plot\n",
    "scatter = px.scatter(df, x='Present_Price', y='Selling_Price', color='Fuel_Type')\n",
    "for trace in scatter.data:\n",
    "    fig.add_trace(trace, row=1, col=1)\n",
    "# Bar chart\n",
    "fuel_counts = df['Fuel_Type'].value_counts().reset_index()\n",
    "fuel_counts.columns = ['Fuel_Type', 'Count']\n",
    "bar = px.bar(fuel_counts, x='Fuel_Type', y='Count', color='Fuel_Type')\n",
    "for trace in bar.data:\n",
    "    fig.add_trace(trace, row=1, col=2)\n",
    "# Line plot\n",
    "line = px.line(df.groupby('Year')['Selling_Price'].mean().reset_index(), x='Year', y='Selling_Price')\n",
    "for trace in line.data:\n",
    "    fig.add_trace(trace, row=2, col=1)\n",
    "# Histogram\n",
    "hist = px.histogram(df, x='Selling_Price', nbins=30)\n",
    "for trace in hist.data:\n",
    "    fig.add_trace(trace, row=2, col=2)\n",
    "# Add dropdown for filtering by Fuel_Type\n",
    "fig.update_layout(\n",
    "    updatemenus=[\n",
    "        dict(\n",
    "            buttons=list([\n",
    "                dict(label='All', method='update', args=[{'visible': [True, True, True, True, True, True, True, True]}, {'title': 'All Fuel Types'}]),\n",
    "                dict(label='Petrol', method='update', args=[{'visible': [True, False, False, False, False, False, False, False]}, {'title': 'Petrol'}]),\n",
    "                dict(label='Diesel', method='update', args=[{'visible': [False, True, False, False, False, False, False, False]}, {'title': 'Diesel'}]),\n",
    "                dict(label='CNG', method='update', args=[{'visible': [False, False, True, False, False, False, False, False]}, {'title': 'CNG'}])\n",
    "            ]),\n",
    "            direction='down',\n",
    "            showactive=True,\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "# Add cards for key metrics as annotations instead of indicators to avoid subplot compatibility issues\n",
    "average_present_price = df['Present_Price'].mean()\n",
    "average_kms_driven = df['Kms_Driven'].mean()\n",
    "fig.add_annotation(text=f\"Average Selling Price: {average_selling_price:.2f}\", xref=\"paper\", yref=\"paper\", x=0.75, y=0.9, showarrow=False, font=dict(size=14, color='white'), bgcolor='blue', bordercolor='black', borderwidth=2, borderpad=4)\n",
    "fig.add_annotation(text=f\"Total Number of Cars: {total_cars}\", xref=\"paper\", yref=\"paper\", x=0.75, y=0.85, showarrow=False, font=dict(size=14, color='white'), bgcolor='green', bordercolor='black', borderwidth=2, borderpad=4)\n",
    "fig.add_annotation(text=f\"Average Present Price: {average_present_price:.2f}\", xref=\"paper\", yref=\"paper\", x=0.75, y=0.8, showarrow=False, font=dict(size=14, color='white'), bgcolor='orange', bordercolor='black', borderwidth=2, borderpad=4)\n",
    "fig.add_annotation(text=f\"Average Kms Driven: {average_kms_driven:.0f}\", xref=\"paper\", yref=\"paper\", x=0.75, y=0.75, showarrow=False, font=dict(size=14, color='white'), bgcolor='purple', bordercolor='black', borderwidth=2, borderpad=4)\n",
    "# Update layout\n",
    "fig.update_layout(height=800, width=1200, title_text='Car Dataset Dashboard with Filters and Metrics')\n",
    "fig.show()\n",
    "       "
   ]
  },
