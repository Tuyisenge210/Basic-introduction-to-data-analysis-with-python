   "source": [
    "# You can further customize the box plot by adding swarm plots to show individual data points or by adjusting the color palette and styling to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.boxplot(x='Fuel_Type', y='Selling_Price', data=df, palette='Set3')\n",
    "sns.swarmplot(x='Fuel_Type', y='Selling_Price', data=df, color='black', alpha=0.6)\n",
    "plt.title('Box Plot of Selling Price by Fuel Type with Swarm Plot', fontsize=16)\n",
    "plt.xlabel('Fuel Type', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
