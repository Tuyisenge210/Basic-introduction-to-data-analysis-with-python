   "source": [
    "#Now make another interactive vosualisations using Bokeh library to create a bar chart showing the count of cars by 'Fuel_Type':\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.io import output_notebook\n",
    "from bokeh.models import ColumnDataSource\n",
    "from bokeh.transform import factor_cmap\n",
    "from bokeh.palettes import Category10\n",
    "output_notebook()\n",
    "fuel_counts = df['Fuel_Type'].value_counts().reset_index()\n",
    "fuel_counts.columns = ['Fuel_Type', 'Count']\n",
    "source = ColumnDataSource(fuel_counts)\n",
    "p = figure(x_range=fuel_counts['Fuel_Type'], title='Count of Cars by Fuel Type', x_axis_label='Fuel Type', y_axis_label='Count', width=800, height=500)\n",
    "p.vbar(x='Fuel_Type', top='Count', width=0.9, source=source, color=factor_cmap('Fuel_Type', palette=Category10[3], factors=fuel_counts['Fuel_Type'].unique()))\n",
    "show(p)\n"
   ]
  },
  {
   "cell_type": "code",
