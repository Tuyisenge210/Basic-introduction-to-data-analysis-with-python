   "source": [
    "import pandas as pd\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.models import ColumnDataSource, HoverTool\n",
    "from bokeh.layouts import column\n",
    "from bokeh.io import output_notebook\n",
    "\n",
    "output_notebook()\n",
    "\n",
    "df = pd.read_csv('car price data.csv')\n",
    "\n",
    "# 1. Avg Selling Price by Fuel\n",
    "fuel_price = df.groupby('Fuel_Type')['Selling_Price'].mean()\n",
    "source1 = ColumnDataSource(data=dict(fuel=fuel_price.index, price=fuel_price.values))\n",
    "p1 = figure(x_range=fuel_price.index, title=\"Avg Selling Price by Fuel\", width=400, height=300)\n",
    "p1.vbar(x='fuel', top='price', width=0.9, source=source1, color='blue')\n",
    "p1.add_tools(HoverTool(tooltips=[(\"Fuel\", \"@fuel\"), (\"Price\", \"@{price}{0.00}\")]))\n",
    "\n",
    "# 2. Fuel vs Transmission\n",
    "fuel_trans = pd.crosstab(df['Fuel_Type'], df['Transmission'])\n",
    "fuels = fuel_trans.index.tolist()\n",
    "manual = fuel_trans['Manual'].tolist() if 'Manual' in fuel_trans.columns else [0]*len(fuels)\n",
    "automatic = fuel_trans['Automatic'].tolist() if 'Automatic' in fuel_trans.columns else [0]*len(fuels)\n",
    "source2 = ColumnDataSource(data=dict(fuels=fuels, Manual=manual, Automatic=automatic))\n",
    "p2 = figure(x_range=fuels, title=\"Fuel vs Transmission\", width=400, height=300)\n",
    "p2.vbar(x='fuels', top='Manual', width=0.4, source=source2, color='green', legend_label='Manual')\n",
    "p2.vbar(x='fuels', top='Automatic', width=0.4, source=source2, color='orange', legend_label='Automatic')\n",
    "p2.legend.location = \"top_left\"\n",
    "\n",
    "# 3. Fuel vs Seller Type\n",
    "fuel_seller = pd.crosstab(df['Fuel_Type'], df['Seller_Type'])\n",
    "dealer = fuel_seller['Dealer'].tolist() if 'Dealer' in fuel_seller.columns else [0]*len(fuels)\n",
    "individual = fuel_seller['Individual'].tolist() if 'Individual' in fuel_seller.columns else [0]*len(fuels)\n",
    "source3 = ColumnDataSource(data=dict(fuels=fuels, Dealer=dealer, Individual=individual))\n",
    "p3 = figure(x_range=fuels, title=\"Fuel vs Seller Type\", width=400, height=300)\n",
    "p3.vbar(x='fuels', top='Dealer', width=0.4, source=source3, color='red', legend_label='Dealer')\n",
    "p3.vbar(x='fuels', top='Individual', width=0.4, source=source3, color='purple', legend_label='Individual')\n",
    "p3.legend.location = \"top_left\"\n",
    "\n",
    "# Display\n",
    "show(column(p1, p2, p3))"
   ]
  }
 ],
