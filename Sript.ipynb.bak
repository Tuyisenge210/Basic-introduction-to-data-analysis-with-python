   "source": [
    "# Graphical representation of crosstab\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.heatmap(pd.crosstab(df['Fuel_Type'], df['Transmission']), annot=True, fmt='d', cmap='Blues')\n",
    "plt.title(\"Heatmap of Fuel Type vs Transmission (counts)\")\n",
    "plt.ylabel('Fuel Type'); plt.xlabel('Transmission')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
