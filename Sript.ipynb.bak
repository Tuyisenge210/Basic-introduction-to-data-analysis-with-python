   "source": [
    "# You can also create a line plot to visualize trends over time or across different categories. For example, to visualize the average selling price by year:\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.lineplot(x='Year', y='Selling_Price', data=df, marker='o', color='blue')\n",
    "plt.title('Average Selling Price by Year', fontsize=16)\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylabel('Average Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show() \n",
    "\n",
    "# You can customize the line plot further by adding confidence intervals, changing the color and style of the lines, or by adding markers to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.lineplot(x='Year', y='Selling_Price', data=df, marker='o', color='blue', ci='sd')\n",
    "plt.title('Average Selling Price by Year with Confidence Interval', fontsize=16)\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylabel('Average Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can also create an area plot to visualize the cumulative distribution of a variable over time or across categories. For example, to visualize the cumulative selling price by year:\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.lineplot(x='Year', y='Selling_Price', data=df, marker='o', color='green')\n",
    "plt.fill_between(df['Year'], df['Selling_Price'], alpha=0.3, color='green')\n",
    "plt.title('Cumulative Selling Price by Year', fontsize=16)\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylabel('Cumulative Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can customize the area plot further by adjusting the color and transparency, adding multiple lines for different categories, or by changing the style of the plot to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.lineplot(x='Year', y='Selling_Price', data=df, marker='o', color='green', hue='Fuel_Type', palette='Set2')\n",
    "plt.fill_between(df['Year'], df['Selling_Price'], alpha=0.3, color='green')\n",
    "plt.title   ('Cumulative Selling Price by Year and Fuel Type', fontsize=16)\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylabel('Cumulative Selling Price', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.legend(title='Fuel Type')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
