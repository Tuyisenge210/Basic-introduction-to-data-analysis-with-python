   "source": [
    "# Now we are going to use Bokeh library to create interactive visualizations. For example, to create an interactive scatter plot of 'Present_Price' vs 'Selling_Price' colored by 'Fuel_Type':\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.io import output_notebook\n",
    "from bokeh.models import ColumnDataSource\n",
    "from bokeh.transform import factor_cmap\n",
    "from bokeh.palettes import Category10\n",
    "output_notebook()  # This will display the plot inline in a Jupyter notebook\n",
    "source = ColumnDataSource(df)\n",
    "p = figure(title='Selling Price vs Present Price by Fuel Type', x_axis_label='Present Price', y_axis_label='Selling Price', width=800, height=500)\n",
    "p.scatter(x='Present_Price', y='Selling_Price', source=source, color=factor_cmap('Fuel_Type', palette=Category10[3], factors=df['Fuel_Type'].unique()))\n",
    "show(p)\n",
    "\n",
    "#make an interactive scatter plot of 'Present_Price' vs 'Selling_Price' colored by 'Fuel_Type' using Bokeh library\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.io import output_notebook\n",
    "from bokeh.models import ColumnDataSource\n",
    "from bokeh.transform import factor_cmap\n",
    "from bokeh.palettes import Category10\n",
    "\n",
    "#output_notebook()"
   ]
  },
