   "source": [
    "# make the same interactive bar chart for two categorical variables 'Fuel_Type' and 'Seller_Type'\n",
    "from bokeh.plotting import figure, show\n",
    "from bokeh.io import output_notebook\n",
    "from bokeh.models import ColumnDataSource\n",
    "from bokeh.transform import factor_cmap\n",
    "from bokeh.palettes import Category10\n",
    "from bokeh.transform import factor_cmap, dodge\n",
    "output_notebook()\n",
    "fuel_seller_counts = pd.crosstab(df['Fuel_Type'], df['Seller_Type']).reset_index()\n",
    "fuel_seller_counts.columns.name = None\n",
    "source = ColumnDataSource(fuel_seller_counts)\n",
    "p = figure(x_range=fuel_seller_counts['Fuel_Type'], title='Count of Cars by Fuel Type and Seller Type', x_axis_label='Fuel Type', y_axis_label='Count', width=800, height=500)\n",
    "p.vbar(x='Fuel_Type', top='Dealer', width=0.4, source=source, color='blue', legend_label='Dealer')\n",
    "output_notebook()\n",
    "fuel_seller_counts = pd.crosstab(df['Fuel_Type'], df['Seller_Type']).reset_index()\n",
    "fuel_seller_counts.columns.name = None\n",
    "source = ColumnDataSource(fuel_seller_counts)\n",
    "p = figure(x_range=fuel_seller_counts['Fuel_Type'], title='Count of Cars by Fuel Type and Seller Type', x_axis_label='Fuel Type', y_axis_label='Count', width=800, height=500)\n",
    "p.vbar(x=dodge('Fuel_Type', -0.2, range=p.x_range), top='Dealer', width=0.4, source=source, color='blue', legend_label='Dealer')\n",
    "p.vbar(x=dodge('Fuel_Type', 0.2, range=p.x_range), top='Individual', width=0.4, source=source, color='orange', legend_label='Individual')\n",
    "p.legend.title = 'Seller Type'\n",
    "p.legend.location = 'top_right'\n",
    "show(p)\n",
    "p.legend.title = 'Seller Type'\n",
    "p.legend.location = 'top_right'\n",
    "show(p)"
   ]
  },
  {
