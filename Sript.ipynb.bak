   "source": [
    "# Bubble charts can be created using the scatter plot function in seaborn or matplotlib, where the size of the points represents an additional variable. For example, to create a bubble chart showing the relationship between 'Present_Price' and 'Selling_Price', with the size of the bubbles representing 'Kms_Driven':\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.scatterplot(x='Present_Price', y='Selling_Price', size='Kms_Driven', data=df, hue='Fuel_Type', palette='Set1', alpha=0.7)\n",
    "plt.title('Selling Price vs Present Price by Fuel Type with Bubble Size for Kms Driven', fontsize=16)\n",
    "plt.xlabel('Present Price', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.legend(title='Fuel Type')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# You can customize the bubble chart further by adjusting the size scaling, changing the color palette, or by adding regression lines to enhance the visualization.\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.scatterplot(x='Present_Price', y='Selling_Price', size='Kms_Driven', data=df, hue='Fuel_Type', palette='Set1', alpha=0.7, sizes=(20, 200))\n",
    "sns.regplot(x='Present_Price', y='Selling_Price', data=df, scatter=False, color='black', line_kws={'linewidth': 1, 'linestyle': '--'})\n",
    "plt.title('Selling Price vs Present Price by Fuel Type with Bubble Size for Kms Driven', fontsize=16)\n",
    "plt.xlabel('Present Price', fontsize=12)\n",
    "plt.ylabel('Selling Price', fontsize=12)\n",
    "plt.legend(title='Fuel Type')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
